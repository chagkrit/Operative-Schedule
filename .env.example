AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_ID=hnbcmu@gmail.com
# Optional: server-held Calendar grant (see README). Get it with scripts/get-calendar-refresh-token.mjs
GOOGLE_REFRESH_TOKEN=
# Admin user list (Vercel Blob, Private store). Added automatically when the store is connected to the
# project in Vercel (Storage -> Connect); needed locally only to run the admin page against a real store.
BLOB_READ_WRITE_TOKEN=
# Key that encrypts the Admin-managed Calendar settings (master calendar + its token). Generate with:
#   openssl rand -base64 32
# Production + Sensitive in Vercel; keep a copy in a password manager; never commit. See docs/owner-pack/calendar-switch-RUNBOOK.md
CALENDAR_SETTINGS_KEY=
